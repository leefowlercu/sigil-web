{
  "name": "sigil-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:demo": "vite dev --port 3000 --mode demo",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:acceptance": "pnpm build && tsx ./testing/agent-browser/run.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/react-devtools": "0.10.0",
    "@tanstack/react-router": "1.167.3",
    "@tanstack/react-router-devtools": "1.166.9",
    "@tanstack/react-router-ssr-query": "1.166.9",
    "@tanstack/react-start": "1.166.14",
    "@tanstack/router-plugin": "1.166.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "agent-browser": "0.21.4",
    "@tailwindcss/typography": "0.5.19",
    "@tanstack/devtools-vite": "0.6.0",
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "28.1.0",
    "prettier": "3.8.1",
    "smol-toml": "1.4.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4",
    "ws": "8.18.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
