{
  "name": "sigil-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "dev:demo": "vp dev --port 3000 --mode demo",
    "build": "vp build",
    "preview": "vp preview",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check .",
    "check": "vp check",
    "test": "pnpm test:unit && pnpm test:acceptance",
    "test:unit": "vitest run",
    "test:acceptance": "node ./scripts/run-acceptance.mjs",
    "test:acceptance:headed": "node ./scripts/run-acceptance.mjs --headed",
    "test:acceptance:review": "node ./scripts/run-acceptance.mjs --review",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-devtools": "0.10.0",
    "@tanstack/react-router": "1.167.3",
    "@tanstack/react-router-devtools": "1.166.9",
    "@tanstack/react-router-ssr-query": "1.166.9",
    "@tanstack/react-start": "1.166.14",
    "@tanstack/router-plugin": "1.166.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.7.0",
    "@tailwindcss/node": "4.2.2",
    "@tailwindcss/typography": "0.5.19",
    "@tanstack/devtools-vite": "0.6.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.1",
    "eslint-plugin-tailwind-canonical-classes": "1.3.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "^4.1.2",
    "ws": "^8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest"
    }
  },
  "packageManager": "pnpm@10.32.1"
}
